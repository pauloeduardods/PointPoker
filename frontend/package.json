  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.2.5"
