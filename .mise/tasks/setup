#!/usr/bin/env bash
#MISE description="First-time project setup"
set -euo pipefail

if [ ! -f .env ]; then
  echo "==> Creating .env from .env.example..."
  cp .env.example .env
fi

echo "==> Installing tools via mise..."
mise install

echo "==> Starting database..."
mise run db:start

echo "==> Installing frontend dependencies..."
mise run frontend:install

echo "==> Building backend..."
mise run backend:build

echo ""
echo "Setup complete! Run 'mise run dev' to start developing (migrations run on backend startup)."
