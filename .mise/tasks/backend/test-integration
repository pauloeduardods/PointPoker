#!/usr/bin/env bash
#MISE description="Run backend tests including repository integration tests against a throwaway Postgres"
#MISE dir="backend"
set -euo pipefail

NAME=pointpoker-test-db
PORT="${TEST_DB_PORT:-55432}"
docker run -d --rm --name "$NAME" -e POSTGRES_USER=test -e POSTGRES_PASSWORD=test -e POSTGRES_DB=test \
  -p "$PORT:5432" postgres:17-alpine >/dev/null
trap 'docker stop "$NAME" >/dev/null' EXIT

until docker exec "$NAME" pg_isready -U test -d test >/dev/null 2>&1; do sleep 0.5; done
sleep 1

TEST_DATABASE_URL="postgres://test:test@localhost:$PORT/test?sslmode=disable" go test -race -count=1 ./...
