#!/usr/bin/env bash
#MISE description="Apply SQL migrations manually (the backend also applies them on startup)"
set -euo pipefail

for f in backend/migrations/*.sql; do
  echo "==> $f"
  docker compose exec -T db psql -v ON_ERROR_STOP=1 \
    -U "${DB_USER:-pointpoker}" -d "${DB_NAME:-pointpoker}" < "$f"
done
